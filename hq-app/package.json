{
  "name": "bugz-hq",
  "productName": "Bugz HQ",
  "version": "0.1.0",
  "description": "Brain Bugz HQ: Projekt-Board und Discord-Overlay",
  "main": "main.js",
  "author": "Brain Bugz",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "discord.js": "14.16.3"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "tech.brainbugz.hq",
    "productName": "Bugz HQ",
    "icon": "icon.ico",
    "files": ["main.js", "preload.js", "discord.js", "store.js", "renderer/**/*", "icon.png", "package.json"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "BugzHQ.exe" }
  }
}
